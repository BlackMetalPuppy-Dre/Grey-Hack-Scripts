currentFile = null

// ==================== FLUSH BATCH ====================
flushBatch = function()
    if globals.batch.len == 0 then return
    
    // Get current file
    if globals.currentFile == null then
        filename = globals.OUTPUT_DIR + globals.BASE_NAME + globals.fileCounter + ".txt"
        globals.currentFile = getFile(filename)
        if globals.currentFile == null then
            print("ERROR: Could not open file")
            globals.batch = []
            return
        end if
    end if
    
    // Read existing content
    existing = globals.currentFile.get_content
    if existing == null then existing = ""
    
    // Build chunk
    chunk = ""
    for word in globals.batch
        if existing == "" and chunk == "" and globals.firstWrite then
            chunk = globals.QUOTE + word + globals.QUOTE
            globals.firstWrite = false
        else
            chunk = chunk + "," + globals.QUOTE + word + globals.QUOTE
        end if
    end for
    
    // Add comma + newline at end of batch
    chunk = chunk + "," + char(10)
    
    // Write back
    globals.currentFile.set_content(existing + chunk)
    globals.batch = []
end function

// ==================== FLUSH FILE ====================
flushFile = function()
    // Flush any remaining batch
    flushBatch()
    
    if globals.wordCounter == 0 then return
    
    // Add to master list
    if globals.currentFile != null then
        filename = globals.OUTPUT_DIR + globals.BASE_NAME + globals.fileCounter + ".txt"
        globals.masterList = globals.masterList + filename + "\n"
        print("  -> Wrote " + globals.wordCounter + " words to " + filename)
    end if
    
    // Reset for next file
    globals.currentFile = null
    globals.wordCounter = 0
    globals.firstWrite = true
    globals.fileCounter = globals.fileCounter + 1
end function

// ==================== ADD WORD ====================
addWord = function(word)
    if word == null or word == "" then return
    globals.batch.push(word)
    globals.wordCounter = globals.wordCounter + 1
    globals.totalWords = globals.totalWords + 1
    
    if globals.batch.len >= globals.BATCH_SIZE then
        flushBatch()
    end if
    
    if globals.wordCounter >= globals.MAX_WORDS_PER_FILE then
        flushFile()
    end if
end function

