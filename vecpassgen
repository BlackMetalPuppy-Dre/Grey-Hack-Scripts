// ==================== FILE HELPERS ====================
getFile = function(filename)
    parts = filename.split("/")
    name = parts[-1]
    folder = parts[:-1].join("/")
    if folder == "" then folder = "/"
    
    computer.touch(folder, name)
    f = computer.File(filename)
    if f == null then
        print("ERROR: Could not get file object for " + filename)
        return null
    end if
    return f
end function

// ==================== COUNTERS ====================
fileCounter = 1
