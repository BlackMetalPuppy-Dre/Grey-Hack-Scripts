// ==================== LEET SPEAK ====================
applyLeet = function(word)
    result = ""
    for c in word
        if c == "a" then
            result = result + "4"
        else if c == "e" then
            result = result + "3"
        else if c == "i" then
            result = result + "1"
        else if c == "o" then
            result = result + "0"
        else if c == "s" then
            result = result + "5"
        else if c == "t" then
            result = result + "7"
        else if c == "g" then
            result = result + "9"
        else if c == "b" then
            result = result + "8"
        else
            result = result + c
        end if
    end for
    return result
end function

