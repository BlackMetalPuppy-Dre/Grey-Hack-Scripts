// ==================== BATCH WRITER ====================
batch = []
batchSize = 200
total = 0

flushBatch = function()
    if batch.len == 0 then return
    existing = outFile.get_content
    if existing == null then existing = ""
    outFile.set_content(existing + batch.join("\n") + "\n")
    batch = []
end function

addWord = function(word)
    if word == null or word == "" then return
    batch.push(word)
    total = total + 1
    if batch.len >= batchSize then
        flushBatch()
    end if
end function

