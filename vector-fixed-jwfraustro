// ==================== CONFIGURATION ====================
LOCAL_USER = "root"
MAX_LENGTH = 10
ORDER = 3
PASSWORD_FILE = "/home/guest/vecpass.txt"

// ==================== MAIN ====================
VECTOR = {}
