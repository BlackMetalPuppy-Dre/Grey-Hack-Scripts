    for file in PASSWORD_FILES
        print("\n<color=#9142DB>[VECTOR]</color> Trying password file: " + file)
        VECTOR.keywords = []
        VECTOR.chains = {}
        if not VECTOR.load_from_file(file) then
            continue
        end if
        VECTOR.build_chain
        result = VECTOR.crack
        if result != null then
            print("\n<color=#00FF00>[VECTOR] Shell obtained from file: " + file + "</color>")
            result.start_terminal
            return
        end if
    end for

    print("\n<color=#FF0000>[VECTOR] Password not found in any of the provided files.</color>")
end function

