            By <color=#C61742>XsisTz</color> (Local)"

VECTOR.keywords = []
VECTOR.alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
VECTOR.attempts = 0
VECTOR.order = ORDER
VECTOR.chains = {}
VECTOR.min_length = 3
VECTOR.max_length = MAX_LENGTH
VECTOR.start_time = 0
VECTOR.found_shell = null

// ==================== LOAD PASSWORDS FROM FILE ====================
VECTOR.load_from_file = function(filename)
    // FIX: use computer.File not shell.launch/cat
    shell = get_shell
    comp = shell.host_computer
    fileObj = comp.File(filename)
    if fileObj == null then
        print("<color=#FF0000>[ERROR] Cannot find password file: " + filename + "</color>")
        return false
    end if
    content = fileObj.get_content
    if content == null or content == "" then
        print("<color=#FF0000>[ERROR] Password file is empty: " + filename + "</color>")
        return false
    end if
    // --- Handle both comma-separated and newline-separated formats ---
    words = []
    quote = char(34)
    if content.indexOf(",") != null then
        // Comma separated: "pass1","pass2",...
        tokens = content.split(",")
        for token in tokens
            token = token.trim
            if token.len >= 2 and token[0] == quote and token[token.len-1] == quote then
                token = token[1:token.len-1]
            end if
            if token != "" then words.push(token)
        end for
    else
        // Newline separated: one password per line
        lines = content.split("\n")
        for line in lines
            line = line.trim
            if line != "" then words.push(line)
        end for
    end if
    VECTOR.keywords = words
    print("<color=#9142DB>[VECTOR]</color> Loaded " + VECTOR.keywords.len + " passwords from " + filename)
    return true
end function

// ==================== BUILD MARKOV CHAIN ====================
VECTOR.build_chain = function
    for word in VECTOR.keywords
        word = word.upper
        i = 0
        while i <= word.len - VECTOR.order - 1
            sub_text = word[i:i + VECTOR.order]
            if not VECTOR.chains.hasIndex(sub_text) then
                VECTOR.chains[sub_text] = []
            end if
            next_char = word[i + VECTOR.order]
            if VECTOR.chains[sub_text].indexOf(next_char) == null then
                VECTOR.chains[sub_text].push(next_char)
            end if
            i = i + 1
        end while
    end for
    print("<color=#9142DB>[VECTOR]</color> " + VECTOR.chains.indexes.len + " chains built.")
end function

// ==================== CONNECT (LOCAL ONLY) ====================
VECTOR.connect = function(password)
    result = get_shell(LOCAL_USER, password)
    if typeof(result) == "shell" then
        return result
    end if
    return null
end function

// ==================== RECURSE ====================
VECTOR.recurse = function(token, max_length)
    password = token.lower
    VECTOR.attempts = VECTOR.attempts + 1
    result = VECTOR.connect(password)
    if result != null then
        print("<color=#00FF00>[+] Password found: <b>" + password + "</b></color>")
        return result
    end if
    if token.len >= max_length then
        return null
    end if
    start_idx = token.len - VECTOR.order
    if start_idx < 0 then return null
    sub_text = token[start_idx:start_idx + VECTOR.order]
    if not VECTOR.chains.hasIndex(sub_text) then
        return null
    end if
    next_chars = VECTOR.chains[sub_text]
    for next_char in next_chars
        new_token = token + next_char
        found = VECTOR.recurse(new_token, max_length)
        if found != null then
            return found
        end if
    end for
    return null
end function

// ==================== CRACK ====================
VECTOR.crack = function
    VECTOR.start_time = time
    VECTOR.attempts = 0
    chain_keys = VECTOR.chains.indexes
    for key in chain_keys
        result = VECTOR.recurse(key, VECTOR.max_length)
        if result != null then
            elapsed = time - VECTOR.start_time
            print("\n<color=#00FF00>[+] Cracked in " + elapsed + " seconds!</color>")
            print("<color=#00FF00>[+] " + VECTOR.attempts + " attempts made</color>")
            VECTOR.found_shell = result
            return result
        end if
    end for
    elapsed = time - VECTOR.start_time
    print("\n<color=#FF0000>[-] Password not found after " + VECTOR.attempts + " attempts.</color>")
    print("<color=#FF0000>[-] Time: " + elapsed + " seconds</color>")
    return null
end function

// ==================== START ====================
VECTOR.start = function
    print(VECTOR.logo)
    print("<color=#9142DB>[VECTOR]</color> Target: Local (" + LOCAL_USER + ")")
    print("<color=#9142DB>[VECTOR]</color> Max length: " + VECTOR.max_length)
    print("<color=#9142DB>[VECTOR]</color> Markov order: " + VECTOR.order)
    print("")
    if not VECTOR.load_from_file(PASSWORD_FILE) then
        print("Aborting.")
        return
    end if
    VECTOR.build_chain
    result = VECTOR.crack
    if result != null then
        print("\n<color=#00FF00>[VECTOR] Shell obtained! You are back in business.</color>")
        result.start_terminal
    end if
end function

// ==================== RUN ====================
VECTOR.start
